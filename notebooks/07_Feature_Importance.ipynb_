4\n","RMSE : 315,622\n","R²   : 0.778\n"]}],"source":["from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n","import numpy as np\n","\n","mae = mean_absolute_error(y_test, y_pred_top5)\n","\n","rmse = np.sqrt(mean_squared_error(y_test, y_pred_top5))\n","\n","r2 = r2_score(y_test, y_pred_top5)\n","\n","print(f\"MAE  : {mae:,.0f}\")\n","print(f\"RMSE : {rmse:,.0f}\")\n","print(f\"R²   : {r2:.3f}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"C4kROlWIu2Q1"},"outputs":[{"name":"stdout","output_type":"stream","text":["144006.22433669353 191572.25370483662 0.9183016593936879\n"]}],"source":["# Prédictions du modèle complet\n","y_pred_full = best_model.predict(X_test)\n","\n","# Métriques du modèle complet\n","mae_full = mean_absolute_error(y_test, y_pred_full)\n","rmse_full = np.sqrt(mean_squared_error(y_test, y_pred_full))\n","r2_full = r2_score(y_test, y_pred_full)\n","\n","print(mae_full, rmse_full, r2_full)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"N82XcBX9vG2T"},"outputs":[],"source":["comparison = pd.DataFrame({\n","    \"Modèle\": [\"GradientBoost complet\", \"GradientBoost Top 5\"],\n","    \"MAE\": [mae_full, mae_top5],\n","    \"RMSE\": [rmse_full, rmse_top5],\n","    \"R²\": [r2_full, r2_top5]\n","})\n","\n","comparison"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"v38il0PByjXE"},"outputs":[],"source":["top10 = feature_importance.head(10)\n","\n","top10"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"yewsYHbgyIiK"},"outputs":[],"source":["\n","\n","# Trier les variables par importance\n","top10 = feature_importance.sort_values(\n","    by=\"Importance\",\n","    ascending=False\n",").head(10)\n","\n","# Création de la figure\n","plt.figure(figsize=(10, 6))\n","\n","plt.barh(\n","    top10[\"Feature\"],\n","    top10[\"Importance\"]\n",")\n","\n","plt.xlabel(\"Importance\", fontsize=12)\n","plt.ylabel(\"Variables\", fontsize=12)