uter\n","\n","from sklearn.preprocessing import (\n","    OneHotEncoder,\n","    StandardScaler,\n","    RobustScaler,OrdinalEncoder\n",")\n","\n","from sklearn.compose import ColumnTransformer\n","\n","from sklearn.pipeline import Pipeline\n","import os\n","\n","os.makedirs(f'{BASE}/images', exist_ok=True)\n","\n","df_rent = pd.read_csv(f'{BASE}/data/rent_prediction.csv')\n","print(\"Loyers   :\", df_rent.shape)\n","df_rent.head()"]},{"cell_type":"code","execution_count":30,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8eXLq3GApBIr","executionInfo":{"status":"ok","timestamp":1785496177292,"user_tz":-120,"elapsed":55,"user":{"displayName":"Chrysanthe Nishimwe","userId":"11119449538391145228"}},"outputId":"c5c3ed3e-eecd-49ff-ea74-03a52ac1c611"},"outputs":[{"output_type":"stream","name":"stdout","text":["(510, 1)\n","Variables explicatives (X) : ['Chambres', 'Salon', 'SalleDeBainInterieure', 'Parking', 'Meuble', 'Jardin', 'Superficie_m2', 'DistanceRoute_m', 'Quartier', 'AgeMaison']\n","Variable cible (y) : LoyerMensuel_BIF\n"]}],"source":["df = df_rent.drop(columns=['IdentifiantMaison']) #suppression de IdentifiantMaison\n","\n","#separation des variables\n","\n","X = df.drop(columns=['LoyerMensuel_BIF'])\n","y = df['LoyerMensuel_BIF']\n","y = df['LoyerMensuel_BIF'].values.reshape(-1,1)\n","\n","print(y.shape)\n","\n","print(\"Variables explicatives (X) :\", X.columns.tolist())\n","print(\"Variable cible (y) : LoyerMensuel_BIF\")\n","\n"]},{"cell_type":"markdown","metadata":{"id":"ZfF-g0oTv7V7"},"source":["Train/Test Split"]},{"cell_type":"code","execution_count":31,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"G2AWdcRLvtuy","executionInfo":{"status":"ok","timestamp":1785496177294,"user_tz":-120,"elapsed":12,"user":{"displayName":"Chrysanthe Nishimwe","userId":"11119449538391145228"}},"outputId":"a05f1b02-040e-42d5-f189-caf1ee0773cc"},"outputs":[{"output_type":"stream","name":"stdout","text":["Taille de l'entraînement : 408 lignes